      "publisherHost": "www.deutsche-biographie.de",
      "status": 200,
      "contentType": "text/html",
      "bytesRead": 99198,
      "sha256": "d5fa0ce9d093e6c0eee804623c82291007aa6b92bb50c3ab45ac65acbc4e975c",
      "verificationMethod": "direct-http-body-capture+reviewed-excerpt",
      "excerpt": "Rudolf Julius Emanuel C. wurde am 2. Januar 1822 in Köslin in Pommern geboren. 1865 schuf er im Anschluß daran den Begriff der „Entropie“, einer Zustandsfunktion, deren Gesamtwert in einem abgeschlossenen System nie abnimmt. Er erlag seiner Krankheit am 24. August desselben Jahres.",
      "excerptSha256": "51b7f395544ddd13d18be789c0d4bd83fb73bbcff77d20df4d89a9302ff288e9"
    },
    {
      "id": "clausius-mactutor",
      "url": "https://mathshistory.st-andrews.ac.uk/Biographies/Clausius/",
      "publisher": "MacTutor History of Mathematics",
      "publisherHost": "mathshistory.st-andrews.ac.uk",
      "status": 200,
      "contentType": "text/html",
      "bytesRead": 47823,
      "sha256": "e9b07ee05f51a517e37ac9b2be05dfba6d3fc65158b657b963df5235221e4a24",
      "verificationMethod": "direct-http-body-capture+reviewed-excerpt",
      "excerpt": "Rudolf Julius Emmanuel Clausius Quick Info Born 2 January 1822 Koslin, Prussia (now Koszalin, Poland) Died 24 August 1888 Bonn, Germany. Clausius's first paper on the mechanical theory of heat was published in 1850. In a paper which he published in 1865 the concept is named and clearly defined for the first time.",
      "excerptSha256": "50f9cef96eb8804a3d3f35baef15f23250f1fa40737ff4e6e8028c5edc4ddcaa"
    },
    {
      "id": "balakirev-pbm",
      "url": "https://polskabibliotekamuzyczna.pl/encyklopedia/balakiriew-2/?lang=en",
